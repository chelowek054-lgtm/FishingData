[
  {
    "id": "carp",
    "names": { "en": "Carp" },
    "translations": {
      "en": {
        "description": "Two different fish under one name. Small and medium carp move in a tight shoal, feed in competition and grab first; a big carp keeps alone or in a small group, follows its own daily route and inspects a spot before settling on it. Who you go for sets both the bait size and the baiting plan. Carp have no miracle scent: smell is only a marker. If no food value stands behind it, the fish quickly links that smell with danger and avoids it.",
        "baits": {
          "cold": [
            "Bloodworm",
            "Maggot",
            "Dung worm",
            "Boilie with alcohol-based flavour"
          ],
          "warm": [
            "Sweetcorn",
            "HNV boilie, 30–40 % protein",
            "Peas",
            "Paste",
            "Tiger nut"
          ]
        },
        "groundbait_notes": {
          "cold": "Minimal baiting, dark colour, spicy or meaty flavour, add bloodworm. Oily flavours lock inside the bait in cold water — the solvent must be alcohol or propylene glycol, or there is no signal at all. On a silty bottom butyric acid helps: it changes the pH around the bait.",
          "warm": "Heavy baiting with a coarse fraction (corn, pellets), fruity and sweet flavours. Keep protein at 30–40 %: less and the table will not hold the fish through a long baiting, more and it overloads the liver. Carp detect betaine, soluble fish protein (CPSP-90) and seafood extracts with receptors on whiskers and lips; enzymes and bird seed speed digestion — the fish is hungry again sooner."
        }
      }
    },
    "axes": { "thermal_guild": "WARM", "trophic": "OMNIVORE", "sense": "CHEMO", "diel": "DAY", "habitat": "LENTIC", "winter": "LOW" },
    "name": "Карп / Сазан",
    "description": "Две разные рыбы под одним именем. Мелкий и средний карп ходит плотной стаей, кормится наперегонки и хватает первым; крупный держится одиночкой или малой группой, ходит своим суточным маршрутом и осматривает точку прежде, чем сесть за неё. От того, за кем едешь, зависит и размер насадки, и схема закорма. Чудо-аромата у карпа нет: запах — только метка. Если за ней не стоит пищевая ценность, рыба быстро связывает этот запах с опасностью и обходит его.",
    "temp": {
      "opt_min": 20.0,
      "opt_max": 27.0,
      "abs_min": 5.0,
      "abs_max": 32.0
    },
    "pressure": {
      "min_mmHg": 740,
      "max_mmHg": 755,
      "max_drop_mmhg": 12,
      "max_rise_mmhg": 10,
      "pressure_recovery_hours": 2
    },
    "oxygen": {
      "comfort_mg_l": 5.0,
      "critical_mg_l": 2.5
    },
    "default_horizon": "bottom",
    "cold_temp_threshold": 14.0,
    "season": { "spawn_temp_min": 18.0, "spawn_temp_max": 22.0, "feed_start_c": 10.0, "post_spawn_recovery_days": 10 },
    "guild": "peaceful",
    "light_activity": { "night": 0.7, "dawn": 1.0, "morning": 0.9, "day": 0.5, "evening": 0.9, "dusk": 1.0 },
    "preferred_structures": [
      "gravel_silt_edge",
      "drop_off",
      "flooded_channel",
      "shell_bed",
      "reeds",
      "bay",
      "snags",
      "windward_shore"
    ],
    "baits": {
      "cold": ["Мотыль", "Опарыш", "Навозный червь", "Бойл на спиртовой ароматике"],
      "warm": ["Кукуруза", "Бойл HNV, 30–40 % белка", "Горох", "Тесто", "Тигровый орех"]
    },
    "groundbait_rules": {
      "cold": {
        "volume": "low",
        "fraction": "fine",
        "sweetness": "none",
        "flavor_profile": "spicy_salty",
        "notes": "Минимальный закорм, тёмный цвет, пряный или мясной аромат, добавить мотыля. Масляная ароматика в холодной воде запирается внутри насадки — растворитель нужен на спирту или пропиленгликоле, иначе сигнала не будет вовсе. По заиленному дну выручает маслянокислая кислота: она меняет pH вокруг насадки"
      },
      "warm": {
        "volume": "high",
        "fraction": "coarse",
        "sweetness": "high",
        "flavor_profile": "sweet_fruity",
        "notes": "Обильный закорм крупной фракцией (кукуруза, пеллетс), фруктовые и сладкие ароматизаторы. Держать 30–40 % белка: меньше — стол не удержит рыбу на долгом закорме, больше — перегружает печень. Бетаин, растворимый рыбный протеин (CPSP-90) и вытяжки из морепродуктов карп ловит рецепторами на усах и губах; ферменты и птичий корм ускоряют усвоение — рыба быстрее снова голодна"
      }
    }
  },
